# ── Entorno local ────────────────────────────────────────────
.env

# ── MLFlow y DB analítica (se regeneran) ─────────────────────
mlflow/mlruns/
mlflow/*.db
db/*.db

# ── Resultados (viven en RESULTS_ROOT fuera del repo) ────────
results/
/data/
repo_viejo/
# ── Sandbox ───────────────────────────────────────────────────
sandbox/**/output/
sandbox/**/.ipynb_checkpoints/
sandbox/**/*.pt
sandbox/**/*.ckpt

# JANUS_SANDBOX_ROOT (.env) puede apuntar dentro del repo en máquinas
# donde no hay HDD separado — se ignora por las dudas.
/sandbox_outputs/

# ── Generadores de configs (privados, no van al repo público) ─
# Descomentar antes de publicar el repo del paper:
# projects/*/generators/

# ── Marcadores de sincronización ──────────────────────────────
.mlflow_run_id

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.ipynb_checkpoints/

# ── matplotlib cache ──────────────────────────────────────────
config/matplotlib_cache/
mlflow/mlflow.db
