# ==== JANUS-BCI :: variables de entorno por máquina ====
# Copiar este archivo a .env y completar con las rutas reales.
# .env NUNCA se versiona (ver .gitignore) — cada máquina (tu laptop,
# el server del instituto) tiene el suyo, con el mismo código arriba.

# Raíz del repo (SSD recomendado, es código versionado)
JANUS_REPO_ROOT=/home/bruno/janus-bci

# Raíz de datos crudos/procesados (HDD, pesado, no versionado)
JANUS_DATA_ROOT=/mnt/hdd/janus_data

# Raíz de resultados de experimentos (HDD o SSD según necesites velocidad
# de escritura). Acá vive el árbol strategy/recipe/dataset/partition/replicate.
JANUS_RESULTS_ROOT=/mnt/hdd/janus_results

# Carpeta de sandbox (pruebas rápidas, descartable, NUNCA trackeado por
# MLFlow ni por la DB analítica)
JANUS_SANDBOX_ROOT=/mnt/hdd/janus_sandbox

# DB analítica (reconstruible, ver db/schema.sql). Si se omite, se usa
# JANUS_REPO_ROOT/db/janus_analytics.db por defecto.
# JANUS_ANALYTICS_DB=/home/bruno/janus-bci/db/janus_analytics.db

# MLFlow: backend local por defecto. Cuando migres a Postgres, solo
# cambiás esta línea (ver PROTOCOL.md, decisión de v2 sobre SQLAlchemy).
MLFLOW_TRACKING_URI=sqlite:////home/bruno/janus-bci/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mnt/hdd/janus_results/mlflow_artifacts

# Solo necesarios si vas a correr scripts/sync/fetch_from_server.sh:
# INSTITUTE_SERVER_HOST=usuario@server.instituto.edu
# INSTITUTE_SERVER_RESULTS_PATH=/home/usuario/janus_results
